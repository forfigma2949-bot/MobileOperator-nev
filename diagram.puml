@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho

' Определение классов

class Абонент {
    - id: int
    - фамилия: string
    - имя: string
    - паспортные_данные: string
    - адрес: string
    + зарегистрировать(): void
    + изменить_данные(): void
    + заблокировать(): void
}

class ЛицевойСчет {
    - номер_лс: string
    - баланс: decimal
    - статус: string
    + пополнить(сумма: decimal): void
    + списать(сумма: decimal): boolean
    + получить_баланс(): decimal
}

class ТарифныйПлан {
    - код_тарифа: int
    - название: string
    - абонентская_плата: decimal
    - минуты_включено: int
    - гигабайты_включено: int
    + изменить_параметры(): void
    + архивировать(): void
}

class Услуга {
    - код_услуги: int
    - название: string
    - стоимость: decimal
    - тип: string
    + подключить(): void
    + отключить(): void
}

class SIMКарта {
    - iccid: string
    - номер_телефона: string
    - статус: string
    + активировать(): void
    + заменить(): void
}

class Звонок {
    - id_звонка: int
    - дата_время: datetime
    - длительность: int
    - тип_звонка: string
    + рассчитать_стоимость(): decimal
}

class Сотрудник {
    - id_сотрудника: int
    - ФИО: string
    - должность: string
    - логин: string
    - пароль: string
    + авторизоваться(): boolean
    + оформить_договор(): void
}

class Договор {
    - номер_договора: string
    - дата_заключения: date
    - срок_действия: date
    + расторгнуть(): void
    + продлить(): void
}

' Определение связей

Абонент "1" -- "1..*" ЛицевойСчет : имеет
Абонент "1" -- "1" Договор : заключает
ТарифныйПлан "1" -- "0..*" Абонент : использует
ЛицевойСчет "1" -- "1" ТарифныйПлан : привязан к
ЛицевойСчет "1" o-- "0..*" Услуга : подключенные услуги
SIMКарта "1" -- "1" Абонент : принадлежит
SIMКарта "1" -- "0..*" Звонок : инициирует
Сотрудник "1" -- "0..*" Договор : оформляет

@enduml